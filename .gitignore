.env
.env.*
*.pem
*.key
*.pfx
*.p12

# Logs and temporary files
*.log
*.tmp
*.temp
~$*

# Large generated experiment artifacts. These remain available locally.
# Only the current Stage-A data and its frozen joint-security dependencies
# are allow-listed below; historical/smoke/archive datasets stay untracked.
outputs/datasets/*
outputs/metrics/**/*.csv
outputs/metrics/*.csv

# Current experiment: legitimate-A public-orbit-error -> Doppler/OLS Stage-A.
!outputs/datasets/orbit_error_to_doppler_legitimate_population.csv
